# 可选：公开访问口令（留空表示不启用口令拦截）
VIEW_PASSCODE=

# 服务端口与刷新周期
BOARD_PORT=18380
TZ=Asia/Shanghai
REFRESH_INTERVAL_SECONDS=15

# 上游容器地址（容器内网地址）
CPAMP_BASE_URL=http://cpa-manager-plus:18317
AIS_BASE_URL=http://aistudio2api:2048
CPA_CONTAINER_AUTH_DIR=/root/.cli-proxy-api

# 宿主机只读挂载路径（请按你的实际部署目录修改）
CPA_AUTHS_DIR=/path/to/CLIProxyAPI/auths
CPA_PRIORITY_DIR=/path/to/CLIProxyAPI/data/antigravity-priority
CPA_LAMPLIGHTER_DIR=/path/to/CLIProxyAPI/plugins/data/lamplighter
AIS_ENV_FILE=/path/to/AIStudio2API/.env

# 外部 Docker 网络名称
CPA_DOCKER_NETWORK=cli-proxy-api_default
AIS_DOCKER_NETWORK=aistudio2api_default
